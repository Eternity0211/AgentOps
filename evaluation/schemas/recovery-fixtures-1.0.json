{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/recovery-safety-fixtures-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixture_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "scenario_id", "input"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proposal_action", "proposal_schema_valid", "evidence_gate_outcome", "stable_predecessor_present", "target_allowlisted", "approval_input", "duplicate_deliveries", "verification_profile"],
            "properties": {
              "proposal_action": {"const": "rollback_service"},
              "proposal_schema_valid": {"type": "boolean"},
              "evidence_gate_outcome": {"enum": ["fail", "pass"]},
              "stable_predecessor_present": {"type": "boolean"},
              "target_allowlisted": {"type": "boolean"},
              "approval_input": {"enum": ["absent", "approved"]},
              "duplicate_deliveries": {"type": "integer", "minimum": 1, "maximum": 100},
              "verification_profile": {"enum": ["not_run", "stable", "unstable"]}
            }
          }
        }
      }
    }
  }
}
