{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/diagnosis-raw-1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "created_at", "dataset_version", "dataset_sha256", "binding", "metadata", "cases"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["rules_version", "rules_sha256", "fairness_policy_version", "fairness_policy_sha256", "fairness_plan_version", "fairness_plan_sha256"],
      "properties": {
        "rules_version": {"$ref": "#/$defs/identifier"}, "rules_sha256": {"$ref": "#/$defs/hash"},
        "fairness_policy_version": {"$ref": "#/$defs/identifier"}, "fairness_policy_sha256": {"$ref": "#/$defs/hash"},
        "fairness_plan_version": {"$ref": "#/$defs/identifier"}, "fairness_plan_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "baseline_id", "baseline_version", "code_revision", "scenario_version", "ground_truth_manifest_set_sha256", "model_id", "model_settings_sha256", "prompt_version", "policy_version", "tool_schema_versions", "python_version", "platform", "hardware_summary", "concurrency", "seed", "started_at", "finished_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"}, "baseline_id": {"$ref": "#/$defs/identifier"}, "baseline_version": {"$ref": "#/$defs/identifier"}, "code_revision": {"$ref": "#/$defs/identifier"},
        "scenario_version": {"type": "string", "minLength": 1, "maxLength": 256}, "ground_truth_manifest_set_sha256": {"$ref": "#/$defs/hash"},
        "model_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "model_settings_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 256}, "policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "tool_schema_versions": {"type": "object", "minProperties": 1, "maxProperties": 50, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 256}, "platform": {"type": "string", "minLength": 1, "maxLength": 256}, "hardware_summary": {"type": "string", "minLength": 1, "maxLength": 256},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 1024}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.1"}, "track": {"const": "diagnosis"}, "created_at": {"type": "string", "format": "date-time"},
    "dataset_version": {"$ref": "#/$defs/identifier"}, "dataset_sha256": {"$ref": "#/$defs/hash"}, "binding": {"$ref": "#/$defs/binding"}, "metadata": {"$ref": "#/$defs/metadata"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "status", "diagnosis_top3", "cited_evidence_ids", "evidence_gate_outcome", "outcome_reason_code", "tool_calls", "input_tokens", "output_tokens", "cost_microusd", "duration_ms", "error_code"],
        "properties": {
          "case_id": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["completed", "failed", "handoff", "refused"]},
          "diagnosis_top3": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "cited_evidence_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "evidence_gate_outcome": {"enum": ["fail", "not_run", "pass"]},
          "outcome_reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
          "tool_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cost_microusd": {"type": "integer", "minimum": 0}, "duration_ms": {"type": "integer", "minimum": 0},
          "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
        }
      }
    }
  }
}
