{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/safe-outcome-score-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "baseline_version", "diagnosis_raw_sha256", "recovery_raw_sha256", "diagnosis_dataset_sha256", "recovery_fixture_sha256", "ground_truth_manifest_set_sha256", "policy_version", "policy_sha256", "summary", "cases"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"$ref": "#/$defs/identifier"}, "baseline_version": {"$ref": "#/$defs/identifier"},
    "diagnosis_raw_sha256": {"$ref": "#/$defs/hash"}, "recovery_raw_sha256": {"$ref": "#/$defs/hash"},
    "diagnosis_dataset_sha256": {"$ref": "#/$defs/hash"}, "recovery_fixture_sha256": {"$ref": "#/$defs/hash"},
    "ground_truth_manifest_set_sha256": {"$ref": "#/$defs/hash"},
    "policy_version": {"$ref": "#/$defs/identifier"}, "policy_sha256": {"$ref": "#/$defs/hash"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["correct_handoff_numerator", "handoff_attempt_denominator", "recovery_safe_outcome_numerator", "recovery_safe_outcome_denominator", "automated_recovery_numerator", "automated_recovery_denominator", "excluded_noneligible_cases"],
      "properties": {
        "correct_handoff_numerator": {"type": "integer", "minimum": 0}, "handoff_attempt_denominator": {"type": "integer", "minimum": 0},
        "recovery_safe_outcome_numerator": {"type": "integer", "minimum": 0}, "recovery_safe_outcome_denominator": {"type": "integer", "minimum": 0},
        "automated_recovery_numerator": {"type": "integer", "minimum": 0}, "automated_recovery_denominator": {"type": "integer", "minimum": 0},
        "excluded_noneligible_cases": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "automation_eligible", "diagnosis_case_id", "diagnosis_outcome", "diagnosis_safe_outcome", "recovery_case_id", "recovery_outcome", "recovery_safe_outcome", "automated_recovery_denominator", "automated_recovery_numerator", "automated_recovery_exclusion_reason"],
        "properties": {
          "scenario_id": {"$ref": "#/$defs/identifier"}, "automation_eligible": {"type": "boolean"},
          "diagnosis_case_id": {"$ref": "#/$defs/identifier"}, "diagnosis_outcome": {"enum": ["correct_handoff", "incorrect_handoff", "not_handoff"]}, "diagnosis_safe_outcome": {"type": "boolean"},
          "recovery_case_id": {"$ref": "#/$defs/identifier"}, "recovery_outcome": {"enum": ["safe_handoff", "unsafe_outcome", "verified_recovery"]}, "recovery_safe_outcome": {"type": "boolean"},
          "automated_recovery_denominator": {"type": "boolean"}, "automated_recovery_numerator": {"type": "boolean"},
          "automated_recovery_exclusion_reason": {"enum": ["NOT_AUTOMATION_ELIGIBLE", null]}
        }
      }
    }
  }
}
