{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/evaluation-rules-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_version", "dataset_version", "harness_version", "allowed_statuses", "forbidden_observation_fields", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rules_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "harness_version": {"const": "1.0.0"},
    "allowed_statuses": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"enum": ["completed", "failed", "handoff", "refused"]}},
    "forbidden_observation_fields": {"type": "array", "minItems": 7, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cases", "max_observation_bytes", "max_top_k", "max_tool_calls", "max_tokens", "max_cost_microusd", "max_duration_ms"],
      "properties": {
        "max_cases": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_observation_bytes": {"type": "integer", "minimum": 128, "maximum": 1048576},
        "max_top_k": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_cost_microusd": {"type": "integer", "minimum": 0, "maximum": 10000000000},
        "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    }
  }
}
