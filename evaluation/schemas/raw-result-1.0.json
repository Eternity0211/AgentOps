{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/evaluation-raw-result-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness_version", "created_at", "dataset_version", "dataset_sha256", "rules_version", "rules_sha256", "metadata", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "harness_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rules_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "baseline_id", "baseline_version", "code_revision", "scenario_version", "ground_truth_manifest_set_sha256", "model_id", "model_settings_sha256", "prompt_version", "policy_version", "tool_schema_versions", "python_version", "platform", "hardware_summary", "concurrency", "seed", "started_at", "finished_at"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "baseline_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "baseline_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "code_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "scenario_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "ground_truth_manifest_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "tool_schema_versions": {"type": "object", "minProperties": 1, "maxProperties": 50, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "hardware_summary": {"type": "string", "minLength": 1, "maxLength": 256},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 1024},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "diagnosis_top3", "cited_evidence_ids", "proposed_action", "executed_actions", "verification_outcome", "tool_calls", "input_tokens", "output_tokens", "cost_microusd", "duration_ms", "error_code"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "status": {"enum": ["completed", "failed", "handoff", "refused"]},
          "diagnosis_top3": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "cited_evidence_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "proposed_action": {"type": ["string", "null"]},
          "executed_actions": {"type": "integer", "minimum": 0, "maximum": 1000},
          "verification_outcome": {"enum": ["fail", "not_run", "pass"]},
          "tool_calls": {"type": "integer", "minimum": 0},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "cost_microusd": {"type": "integer", "minimum": 0},
          "duration_ms": {"type": "integer", "minimum": 0},
          "error_code": {"type": ["string", "null"]}
        }
      }
    }
  }
}
