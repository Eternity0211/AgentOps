# Copy to .env and replace every REQUIRED value before starting a profile.
# The committed example intentionally contains no working credentials.
COMPOSE_PROJECT_NAME=agentops
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080

CONTROL_DB_NAME=agentops
CONTROL_DB_USER=agentops
CONTROL_DB_PASSWORD_FILE=./secrets/control-db-password.txt

SIMULATOR_DB_NAME=commerce
SIMULATOR_DB_USER=simulator
SIMULATOR_DB_PASSWORD_FILE=./secrets/simulator-db-password.txt
SIMULATOR_REDIS_PASSWORD_FILE=./secrets/simulator-redis-password.txt

# Used only with compose.evaluation.yaml; never expose this file to runtime profiles.
GROUND_TRUTH_ACCESS_FILE=./secrets/ground-truth-access.txt

# Version markers are diagnostic facts. Keep IDs unique for each controlled rollout.
GATEWAY_SERVICE_VERSION=1.0.0
GATEWAY_DEPLOYMENT_ID=baseline-gateway-v1
GATEWAY_PREVIOUS_VERSION=
ORDER_SERVICE_VERSION=1.0.0
ORDER_DEPLOYMENT_ID=baseline-order-v1
ORDER_PREVIOUS_VERSION=
INVENTORY_SERVICE_VERSION=1.0.0
INVENTORY_DEPLOYMENT_ID=baseline-inventory-v1
INVENTORY_PREVIOUS_VERSION=
PAYMENT_SERVICE_VERSION=1.0.0
PAYMENT_DEPLOYMENT_ID=baseline-payment-v1
PAYMENT_PREVIOUS_VERSION=

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=24h
LOKI_PORT=3100
TEMPO_PORT=3200
