{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/evaluation-dataset-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "scenario_id", "split", "observation"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "split": {"enum": ["evaluation", "regression"]},
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alert_summary", "time_window_minutes", "signals", "available_tools"],
            "properties": {
              "alert_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
              "time_window_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
              "signals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "summary"],
                  "properties": {
                    "source": {"enum": ["deployments", "logs", "metrics", "topology", "traces"]},
                    "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
                  }
                }
              },
              "available_tools": {
                "type": "array",
                "maxItems": 20,
                "items": {"type": "string", "minLength": 1, "maxLength": 64}
              }
            }
          }
        }
      }
    }
  }
}
