{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/ground-truth-manifest-1.0.json",
  "title": "AgentOps evaluation-only Ground Truth manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "scenario_id", "target_service", "cause", "symptoms", "key_evidence", "deployment_change", "automation_eligible", "eligibility_prerequisites", "expected_safe_outcome", "handoff_reason_code", "recovery_action", "verification", "evaluator_cleanup", "future_tool_requirement"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"const": "phase1c-v1"},
    "scenario_id": {"enum": ["http-500", "db-pool-exhaustion", "redis-timeout", "downstream-latency", "memory-leak", "bad-configuration"]},
    "target_service": {"enum": ["order", "inventory", "payment"]},
    "cause": {"type": "string", "minLength": 1},
    "symptoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "key_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["metrics", "logs", "traces", "deployments"],
      "properties": {
        "metrics": {"type": "array", "items": {"type": "string"}},
        "logs": {"type": "array", "items": {"type": "string"}},
        "traces": {"type": "array", "items": {"type": "string"}},
        "deployments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deployment_change": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["introduced_version", "stable_predecessor"], "properties": {"introduced_version": {"const": "2.0.0"}, "stable_predecessor": {"const": "1.0.0"}}}
      ]
    },
    "automation_eligible": {"type": "boolean"},
    "eligibility_prerequisites": {"type": "array", "items": {"type": "string"}},
    "expected_safe_outcome": {"enum": ["approved_rollback_or_handoff", "human_handoff"]},
    "handoff_reason_code": {"type": ["string", "null"]},
    "recovery_action": {"enum": ["rollback_service", null]},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evaluator_cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "readiness_check", "recovery_credit"],
      "properties": {"action": {"const": "fault_clean"}, "readiness_check": {"const": "simulator_status"}, "recovery_credit": {"const": false}}
    },
    "future_tool_requirement": {"type": ["string", "null"]}
  }
}
